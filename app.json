{
  "expo": {
    "name": "TheDesk",
    "slug": "TootDesk",
    "version": "2.1.4",
    "ios": {
      "buildNumber": "109",
      "supportsTablet": true,
      "bundleIdentifier": "top.thedesk.toot",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/desk.png",
    "scheme": "tootdesk",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/bundle/en.json",
      "ja": "./locales/bundle/ja.json"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "top.thedesk.toot"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/desk.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 4,
              "supportsText": true,
              "supportsMovieWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba984335-bb74-42cf-9fc5-0420d1936731"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ba984335-bb74-42cf-9fc5-0420d1936731"
    }
  }
}
